#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# The product only offers a current-user install. PackageKit passes the volume
# as argument 3 and its HOME may be unset, so resolve the effective user.
uid=$(id -u)
home=$(dscacheutil -q user -a uid "$uid" | sed -n 's/^dir: //p')
case "$home" in /*) ;; *) exit 1 ;; esac
if [ "$uid" -eq 0 ] || [ "$(stat -f %u "$home")" != "$uid" ]; then
  echo "Kanade requires installation in the current user's home directory." >&2
  exit 1
fi

temporary=$(getconf DARWIN_USER_TEMP_DIR)
stage=$(mktemp -d "${temporary%/}/kanade-pkg.XXXXXXXX")
trap '/bin/rm -rf "$stage"' EXIT
trap 'exit 1' HUP INT TERM
ditto -x -k "$(dirname "$0")/Kanade.zip" "$stage"
app="$stage/Kanade.app"
codesign --verify --deep --strict "$app"

env -i HOME="$home" PATH="$PATH" TMPDIR="$temporary" \
  "$app/Contents/MacOS/kanade-installer" install-macos --bundle "$app" --preview-pkg
