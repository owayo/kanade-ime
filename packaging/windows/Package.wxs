<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Kanade IME" Manufacturer="Kanade" Version="$(var.Version)"
           UpgradeCode="C8E8A998-6DC8-47CE-9203-9635946B8A16" Language="1041" Scope="perMachine">
    <!-- Install the same component GUIDs before the cached old MSI removes its
         product. Older packages can shut down TIP hosts when their DLL loses
         its last component reference. Keep both steps inside the transaction. -->
    <!-- Windows Installer compares only the first three fields of a version,
         and builds that differ only in their preview number share them. A
         build with the same version replaces the installed one, rather than
         being installed beside it. -->
    <MajorUpgrade DowngradeErrorMessage="A newer Kanade version is already installed." Schedule="afterInstallExecute" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <!-- The TIP is loaded into editors. Let users save and restart them themselves. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Launch Condition="Installed OR (VersionNT64 AND NOT Arm64)" Message="Kanade requires x64 Windows." />
    <Property Id="VC_X64_INSTALLED">
      <RegistrySearch Id="FindVc64" Root="HKLM" Key="Software\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Name="Installed" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="VC_X86_INSTALLED">
      <RegistrySearch Id="FindVc32" Root="HKLM" Key="Software\Microsoft\VisualStudio\14.0\VC\Runtimes\x86" Name="Installed" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="VC_X64_COMPAT_INSTALLED">
      <RegistrySearch Id="FindVc64CompatibilityView" Root="HKLM" Key="Software\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Name="Installed" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="VC_X86_NATIVE_INSTALLED">
      <RegistrySearch Id="FindVc32NativeView" Root="HKLM" Key="Software\Microsoft\VisualStudio\14.0\VC\Runtimes\x86" Name="Installed" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR ((VC_X64_INSTALLED = &quot;#1&quot; OR VC_X64_COMPAT_INSTALLED = &quot;#1&quot;) AND (VC_X86_INSTALLED = &quot;#1&quot; OR VC_X86_NATIVE_INSTALLED = &quot;#1&quot;))" Message="Install the current Microsoft Visual C++ Redistributable for x64 and x86 before installing Kanade. See the included README." />
    <!-- The file name of an extracted icon is its identifier, so it ends in .ico. -->
    <Icon Id="Kanade.ico" SourceFile="artifacts/windows/Kanade.ico" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Kanade">
        <!-- Opens the settings from the Start menu. The package is per-machine, so
             the shortcut is in the menu of every user. Windows Installer
             validation (ICE43, ICE57) requires a key path under HKCU for a
             shortcut that is not advertised. -->
        <Component Id="SettingsShortcut" Guid="EA1C3594-DE96-4EA2-B081-3AF027B26D37" Bitness="always64">
          <RegistryValue Root="HKCU" Key="Software\Kanade" Name="SettingsShortcut" Type="integer" Value="1" KeyPath="yes" />
          <Shortcut Id="SettingsShortcut" Directory="ProgramMenuFolder" Name="Kanade の設定" Description="Kanade の設定を開きます" Target="[INSTALLDIR]kanade-ui.exe" WorkingDirectory="INSTALLDIR" Icon="Kanade.ico" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Main" Title="Kanade" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="SettingsShortcut" />
    </Feature>
    <!-- Change the logon task only once the file/TSF transaction succeeds.
         The outgoing MSI leaves the task to its replacement on a major upgrade.
         The embedded helper is also available after RemoveFiles on uninstall. -->
    <Binary Id="LogonTaskHelper" SourceFile="artifacts/windows/kanade-installer.exe" />
    <Property Id="KanadeLogonAction" Value="remove-logon-task" />
    <SetProperty Id="KanadeLogonAction" Value="register-logon-task &quot;[INSTALLDIR]kanade-engine.exe&quot;" Before="ApplyLogonTask" Sequence="execute" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="ApplyLogonTask" BinaryRef="LogonTaskHelper" ExeCommand="[KanadeLogonAction]" Execute="commit" Impersonate="no" Return="check" />
    <CustomAction Id="ApplyLogonTaskWithoutRollback" BinaryRef="LogonTaskHelper" ExeCommand="[KanadeLogonAction]" Execute="deferred" Impersonate="no" Return="check" />
    <!-- Rollback actions are scheduled before the corresponding registration. -->
    <CustomAction Id="Rollback64" Directory="INSTALLDIR" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[INSTALLDIR]kanade_tip.dll&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="Rollback32" Directory="INSTALLDIR" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s /u &quot;[INSTALLDIR]x86\kanade_tip.dll&quot;" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="Register64" Directory="INSTALLDIR" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLDIR]kanade_tip.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Register32" Directory="INSTALLDIR" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[INSTALLDIR]x86\kanade_tip.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Restore64" Directory="INSTALLDIR" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLDIR]kanade_tip.dll&quot;" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="Restore32" Directory="INSTALLDIR" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[INSTALLDIR]x86\kanade_tip.dll&quot;" Execute="rollback" Impersonate="no" Return="check" />
    <CustomAction Id="Unregister64" Directory="INSTALLDIR" ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[INSTALLDIR]kanade_tip.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="Unregister32" Directory="INSTALLDIR" ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s /u &quot;[INSTALLDIR]x86\kanade_tip.dll&quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="TestRollback" Directory="INSTALLDIR" ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c exit 1" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <!-- The old uninstaller unregisters the TIP. Register the new one after it. -->
      <Custom Action="Rollback64" After="RemoveExistingProducts" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Register64" After="Rollback64" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Rollback32" After="Register64" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Register32" After="Rollback32" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="TestRollback" After="Register32" Condition="KANADE_TEST_ROLLBACK = 1" />
      <Custom Action="ApplyLogonTask" After="TestRollback" Condition="NOT UPGRADINGPRODUCTCODE AND NOT RollbackDisabled" />
      <Custom Action="ApplyLogonTaskWithoutRollback" After="ApplyLogonTask" Condition="NOT UPGRADINGPRODUCTCODE AND RollbackDisabled" />
      <Custom Action="Restore64" Before="Unregister64" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Unregister64" Before="Restore32" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Restore32" Before="Unregister32" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="Unregister32" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
