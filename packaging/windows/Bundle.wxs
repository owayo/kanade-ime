<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Kanade IME" Manufacturer="Kanade" Version="$(var.Version)"
          UpgradeCode="E33FC3F5-85CE-4B46-92A7-0F3CB5D8FA33" Compressed="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
          LicenseUrl="https://github.com/owayo/kanade-ime/blob/main/LICENSE"
          LocalizationFile="packaging/windows/Installer.ja-jp.wxl"
          LaunchTarget="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"
          LaunchArguments="-NoLogo -NoProfile -WindowStyle Hidden -ExecutionPolicy RemoteSigned -File &quot;[ProgramFiles64Folder]Kanade\setup-user.ps1&quot;"
          SuppressOptionsUI="yes" ShowVersion="yes" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage Id="KanadeMsi" SourceFile="artifacts/windows/Kanade.msi"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
